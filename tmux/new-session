#!/bin/sh
# Cmd+Shift+j (ghostty) popup: asks a name for a new session in the popup's folder (the pane's), then
# switches to it. Enter with no name gives the lowest free number (a ghost in the bar); Esc cancels.
# "new-session create CLIENT NAME" only creates and switches (no prompt): tmux/sessions calls it from its
# own name line ("+ new session" in the Cmd+j popup); it prints why it failed and exits 1 if it can't

# no name: the lowest free number from 1 (tmux's own counter only grows, giving 4, 7, 9...)
create() {
  client=$1 name=$2
  if [ -z "$name" ]; then
    name=1
    while tmux has-session -t "=$name" 2>/dev/null; do name=$((name + 1)); done
  fi
  id=$(tmux new-session -d -P -F '#{session_id}' -c "$PWD" -s "$name" 2>/dev/null) || {
    if tmux has-session -t "=$name" 2>/dev/null; then echo "\"$name\" already exists"; else echo "can't create \"$name\""; fi
    return 1
  }
  tmux switch-client -c "$client" -t "$id"
}
[ "$1" = create ] && { create "$2" "$3"; exit; }

# fzf is only the input line here (no list): with no match it prints the query and exits 1, Esc exits 130
name=$(: | fzf --print-query --no-info --no-separator --layout reverse --pointer '' --prompt '› ' \
  --ghost 'empty: next free number' \
  --color 'bg:-1,fg:#DCD3F0,query:#DCD3F0,prompt:#A884E8,gutter:-1,ghost:#6F6590')
[ $? -eq 130 ] && exit 0

# the client that opened the popup (Cmd+Shift+j's display-popup doesn't expand formats in its command, so
# it can't pass it)
client=$(tmux display -p '#{client_name}')
err=$(create "$client" "$name") || tmux display -c "$client" "session $err"
