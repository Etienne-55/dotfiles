# `git diff dev` / `git diff master`: everything this branch changed (commits and
# uncommitted work) since it left origin's develop/master, fetched first, in nvim's
# diffview (q quits). `dev` is short for develop. Paths, commits and every other git
# command run as usual.
git() {
  if [[ $1 == diff && $# -eq 2 && $2 != -* && ! -e $2 ]]; then
    local base=$2
    [[ $base == dev ]] && base=develop
    if command git rev-parse --verify --quiet "refs/remotes/origin/$base" >/dev/null; then
      command git fetch --quiet origin "$base" || print -u2 "fetch failed, using the last fetched origin/$base"
      nvim "+DiffviewOpen $(command git merge-base "origin/$base" HEAD)" "+autocmd User DiffviewViewClosed qall"
      return
    fi
  fi
  command git "$@"
}

# changed files with diff preview (same as <space>gd in nvim)
alias gd='nvim "+Pick git_status"'

# commits, <cr> lists the files they touched (same as <space>gc / <space>gm in nvim);
# gn jumps straight to the files of my last commit (<space>gn)
alias gc='nvim "+Pick commits"'
alias gm='nvim "+Pick my_commits"'
alias gn='nvim "+Pick my_last_commit"'

# worktrees, <cr> opens the dashboard in the picked one; the shell follows it on
# exit (same as <space>gw in nvim)
gw() {
  git rev-parse --git-dir >/dev/null || return
  nvim "+Pick worktrees"
}

# bare `fd` opens the nvim directory picker (same as <space>fd);
# `fd <args>` still runs the real fd binary
fd() {
  if [ $# -eq 0 ]; then
    nvim "+Pick directory"
  else
    command fd "$@"
  fi
}

