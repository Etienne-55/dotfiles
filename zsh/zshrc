# `git push` on the command line glows in a moving rainbow. A background ticker
# (zle -F on a pipe that prints every 80ms) shifts the colors while the line
# matches; it stops when the line changes or runs. Hooked after the syntax
# highlighter so the rainbow paints over it.
_rainbow_colors=(ff5f5f ff9f43 ffd93d a8e05f 4ade80 2dd4bf 38bdf8 60a5fa 818cf8 a78bfa e879f9 f472b6)
typeset -gi _rainbow_frame=0 _rainbow_fd=0

_rainbow_stop() {
  (( _rainbow_fd )) || return
  zle -F $_rainbow_fd
  exec {_rainbow_fd}<&-
  _rainbow_fd=0
}

_rainbow_paint() {
  setopt localoptions extendedglob
  region_highlight=( "${(@)region_highlight:#*memo=rainbow*}" )
  if [[ $BUFFER != [[:space:]]#git[[:space:]]##push([[:space:]]*|) ]]; then
    _rainbow_stop
    return 0
  fi
  local i n=${#_rainbow_colors}
  for (( i = 0; i < ${#BUFFER}; i++ )); do
    region_highlight+=( "$i $((i + 1)) fg=#${_rainbow_colors[(i - _rainbow_frame + n) % n + 1]},bold, memo=rainbow" )
  done
  (( _rainbow_fd )) && return 0
  exec {_rainbow_fd}< <(while sleep 0.08; do print; done)
  zle -F -w $_rainbow_fd _rainbow_tick
}

_rainbow_tick() {
  read -u $_rainbow_fd || { _rainbow_stop; return }
  (( _rainbow_frame = (_rainbow_frame + 1) % ${#_rainbow_colors} ))
  _rainbow_paint
  zle -R
}

zle -N _rainbow_tick
zle -N _rainbow_paint
zle -N _rainbow_finish _rainbow_stop
autoload -Uz add-zle-hook-widget
add-zle-hook-widget zle-line-pre-redraw _rainbow_paint
add-zle-hook-widget zle-line-finish _rainbow_finish

alias vim="nvim"

# after <space>gw moved nvim into another worktree, the shell follows it on exit
nvim() {
  local cwd_file=$(mktemp)
  NVIM_CWD_FILE=$cwd_file command nvim "$@"
  local code=$? dir=$(<"$cwd_file")
  rm -f "$cwd_file"
  [[ -n $dir && -d $dir ]] && cd "$dir"
  return $code
}

# plain `tmux` always attaches to session 0 (creates it if missing) instead of opening a new session
tmux() {
  if [ $# -eq 0 ]; then
    command tmux new-session -A -s 0
  else
    command tmux "$@"
  fi
}

